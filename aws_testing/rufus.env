# Required arguments
JOB_THRESHOLD=10      				    # Number of jobs to run in parallel
THREAD_LIMIT=20           				# Number of threads allotted to individual RUFUS run
HOST_DATA_DIR=""        	    		# Input files need to be in this directory
SUBJECT_FILE=""         				# Must be in HOST_DATA_DIR
REFERENCE_FASTA="GCA_000001405.15_GRCh38_no_alt_analysis_set.fa" # Must be in HOST_DATA_DIR

# Required recommended arguments
RUFUS_DOCKER_IMAGE="rufus:latest"	
WINDOW_SIZE=1000
KMER_DEPTH_CUTOFF=5
KMER_LENGTH=25
KG1_HASH_DEPTH=150
OTHER_FLAGS="-L -vs"
CONTROL_HASH_VERSION="v1.0"
KG1_HASH_VERSION="v3.0"

# Optional arguments
REGION_FILE="grch38_1mb_regions.txt"    # Leave empty for whole genome; else should be in ${HOST_DATA_DIR}/rufus_resources
CONTROL_FILE_ARRAY=()
