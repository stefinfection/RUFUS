# Required arguments
JOB_THRESHOLD=1          				# Number of jobs to run in parallel
THREAD_LIMIT=20           				# Number of threads per RUFUS iteration
HOST_DATA_DIR="~/test_data/"        	# Input files need to be in this directory
CONTAINER_PATH="~/rufus_epsilon.sif"	# Path to RUFUS docker container
SUBJECT_FILE="subject_test.bam"         # Must be in HOST_DATA_DIR
REFERENCE_FASTA="GCA_000001405.15_GRCh38_no_alt_analysis_set.fa" # Must be in HOST_DATA_DIR

# Required recommended arguments
WINDOW_SIZE=1000
KMER_DEPTH_CUTOFF=5
KMER_LENGTH=25
KG1_HASH_DEPTH=150
OTHER_FLAGS="-L -vs"
REGION_FILE="grch38_1mb_regions.txt"
CONTROL_HASH_VERSION="v1"
KG1_HASH_VERSION="v3"

# Optional arguments
CONTROL_FILE_ARRAY=()