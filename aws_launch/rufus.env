# Required arguments
SUBJECT_FILE=""         				                         # Full path to file
REFERENCE_FASTA="GCA_000001405.15_GRCh38_no_alt_analysis_set.fa" # Full path to file
THREAD_LIMIT=20           				                         # Number of threads allotted to individual RUFUS run
KMER_DEPTH_CUTOFF=5                                              # How many times a kmer must be seen in a subject to be retained
RUFUS_DOCKER_IMAGE="rufus:latest"

# Optional arguments
KMER_LENGTH=                            # Defaults to 25
WORKING_DIR=        	    		    # If you don't want RUFUS working in the current directory
JOB_THRESHOLD=10      				    # Number of jobs to run in parallel if using region mode
WINDOW_SIZE=1000                        # Leave empty for whole genome mode
REGION_FILE="grch38_1mb_regions.txt"    # Leave empty for whole genome, use full path if not
CONTROL_HASH_VERSION="v1.0"             # Necessary only if want to fetch non-default hash version
CONTROL_HASH_LOCAL_DIR=""               # Leave empty if only using paired control or want to fetch from S3 as needed
CONTROL_FILE_ARRAY=()                   # May be in different locations, use full paths
NO_KG1_REMOVAL=""                       # Set to "TRUE" if want to keep variants found in 1000G cohort (will override KG1_HASH_LOCAL_DIR and KG1_HASH_VERSION)
KG1_HASH_LOCAL_DIR=""                   # Leave empty if want to fetch from S3 as needed
KG1_HASH_VERSION="v3.0"                 # Necessary only if want to fetch non-default hash version
KEEP_DOWNLOADED_HASHES=""               # Set to TRUE if want to keep downloaded hashes in working directory for subsequent RUFUS runs (NOTE: ~1TB worth of data!)
OTHER_FLAGS="-L -vs"                    # See RUFUS github for all options