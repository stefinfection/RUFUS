Bootstrap: library
From: ubuntu:22.04

%labels
    Author Stephanie Georges
    Version v0.1.0-epsilon

%post
    export DEBIAN_FRONTEND=noninteractive
    export HTSLIB_VERSION="1.21"

    apt-get update
    apt-get install -y git cmake wget g++ build-essential software-properties-common zlib1g-dev libbz2-dev bc libgsl0-dev libncurses5-dev autoconf automake make liblzma-dev libcurl4-gnutls-dev libssl-dev vt parallel gawk libjsoncpp-dev libjsoncpp25 curl unzip
    add-apt-repository ppa:ubuntu-toolchain-r/test

    # install aws-cli
    curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
    unzip awscliv2.zip
    ./aws/install
    rm -rf awscliv2.zip aws
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Note: the following versions were updated Jan 2025

    # install htslib
    cd /opt
    git clone --recurse-submodules https://github.com/samtools/htslib.git --branch "$HTSLIB_VERSION"
    cd htslib
    autoreconf -i
    ./configure
    make
    make install

    # install samtools
    cd /opt
    git clone https://github.com/samtools/samtools.git --branch "$HTSLIB_VERSION"
    cd samtools
    autoheader
    autoconf -Wno-syntax
    ./configure --with-htslib=/opt/htslib/
    make

    # install bcftools
    cd /opt
    git clone https://github.com/samtools/bcftools.git --branch "$HTSLIB_VERSION"
    cd bcftools
    autoheader
    autoconf
    ./configure --with-htslib=/opt/htslib/ --enable-libgsl
    make

	# install bamtools
    cd /opt
    git clone https://github.com/pezmaster31/bamtools.git --branch v2.5.2
    cd bamtools/
    mkdir build
    cd build/
    cmake -DCMAKE_INSTALL_PREFIX=/opt/bamtools/build ..
    make

    # install bedtools
    cd /opt
    wget https://github.com/arq5x/bedtools2/releases/download/v2.31.1/bedtools-2.31.1.tar.gz
    tar -zxvf bedtools-2.31.1.tar.gz
    cd bedtools2
    make

    # install rufus
    cd /opt
    git clone https://github.com/stefinfection/RUFUS.git
    cd RUFUS
    git checkout singularity_epsilon 
    mkdir bin
    cd bin
    cmake ../
    make    

    apt-get purge -y --auto-remove git wget
	unset DEBIAN_FRONTEND

%environment
    export PATH=$PATH:/opt/RUFUS/bin
    export RUFUS_ROOT=/opt/RUFUS
    export LC_CTYPE=en_US.UTF-8
    export LANG=en_US.UTF-8
    export LANGUAGE=en_US.UTF-8

%test
    /opt/samtools/samtools || true
    /opt/bamtools/build/src/bamtools || true
    /opt/bedtools2/bin/bedtools || true
    bgzip || true
