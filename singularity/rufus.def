Bootstrap: library
From: ubuntu:22.04

%labels
    Author Stephanie Georges
    Version v1.0.1-delta

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y git cmake wget g++ build-essential software-properties-common zlib1g-dev libbz2-dev bc libncurses5-dev autoconf automake make liblzma-dev libcurl4-gnutls-dev libssl-dev samtools bedtools bcftools vt parallel gawk libjsoncpp-dev libjsoncpp25
    add-apt-repository ppa:ubuntu-toolchain-r/test

    # Note: the following versions were updated Jan 2025

    # install htslib
    cd /opt
    git clone --recurse-submodules https://github.com/samtools/htslib.git --branch 1.21
    cd htslib
    autoreconf -i
    ./configure
    make

    # install samtools
    cd /opt
    git clone https://github.com/samtools/samtools.git --branch 1.21
    cd samtools
    autoheader
    autoconf -Wno-syntax
    ./configure --with-htslib=/opt/htslib/
    make

	# install bamtools
    cd /opt
    git clone https://github.com/pezmaster31/bamtools.git --branch v2.5.2
    cd bamtools/
    mkdir build
    cd build/
    cmake -DCMAKE_INSTALL_PREFIX=/opt/bamtools/build ..
    make

    # install bedtools
    cd /opt
    wget https://github.com/arq5x/bedtools2/releases/download/v2.31.1/bedtools-2.31.1.tar.gz
    tar -zxvf bedtools-2.31.1.tar.gz
    cd bedtools2
    make

    # install rufus
    cd /opt
    git clone https://github.com/stefinfection/RUFUS.git
    cd RUFUS
    git checkout singularity_delta 
    mkdir bin
    cd bin
    cmake ../
    make    

    apt-get purge -y --auto-remove git wget
	unset DEBIAN_FRONTEND

%environment
    export PATH=$PATH:/opt/RUFUS/bin
    export RUFUS_ROOT=/opt/RUFUS
    export LC_CTYPE=en_US.utf8

%test
    samtools || true
    bamtools || true
    bedtools || true
    bgzip || true
