# Must match constants of same name in setup_rufus.sh
RUN_DIR="/work/"
RUNTIME_TEMP_DIR="${RUN_DIR}rufus_temp/"
INTERNAL_CONFIG_PATH="${RUNTIME_TEMP_DIR}rufus_config.yaml"

# TODO: need to update all of these after move

# --------- Helper scripts --------- #
RUFUS_DIR="/opt/RUFUS/"
CONTAINER_LAUNCH_DIR="${RUFUS_DIR}container_launch/"
ENTRY_SCRIPT="${RUFUS_DIR}runRufus.sh"
POST_SCRIPT="${RUFUS_DIR}post_process/post_process.sh"
INDEX_BUILD_SCRIPT="${RUFUS_DIR}resource_helpers/build_bwa_indexes.sh"
DOWNLOAD_HASH_SCRIPT="${RUFUS_DIR}resource_helpers/download_hash.sh"

MOUNT_HELPERS="${CONTAINER_LAUNCH_DIR}internal_scripts/internal_mount_helpers.sh"
EXEC_HELPERS="${CONTAINER_LAUNCH_DIR}internal_scripts/internal_exec_helpers.sh"

# --------- Helpers run on host machine --------- #
ARGS_WRAPPER="${CONTAINER_LAUNCH_DIR}external_scripts/docker_only/get_args.sh"
DOCKER_REG_WRAPPER="${CONTAINER_LAUNCH_DIR}external_scripts/docker_only/process_region.sh"

# --------- Temporary directories (not persistent after run) --------- #
REF_INDEX_DIR="${RUNTIME_TEMP_DIR}bwa_indexes/"

# Keep local and remote separate, because we don't want to mount RO if local
INTERNAL_LOCAL_CONTROL_HASH_DIR="${RUNTIME_TEMP_DIR}local_ctrl_hashes/"
INTERNAL_LOCAL_KG1_HASH_DIR="${RUNTIME_TEMP_DIR}local_kg1_hashes/"

# Should make this directory every time - even if local assigned - in the event of a missing hash
INTERNAL_REMOTE_CONTROL_HASH_DIR="${RUNTIME_TEMP_DIR}remote_ctrl_hashes/"
INTERNAL_REMOTE_KG1_HASH_DIR="${RUNTIME_TEMP_DIR}remote_kg1_hashes/"

# --------- Supplementary directories (retained post run) --------- #
SUPP_DIR="${RUN_DIR}rufus_supplementals/"
LOGS_DIR="${SUPP_DIR}rufus_logs/"    # Want outside of temp dir so persistent

# --------- Versioning --------- #
DEFAULT_KG1_HASH_VERSION="v3.0"
DEFAULT_CONTROL_HASH_VERSION="v1.0"
RUFUS_VERSION="0.1.0"